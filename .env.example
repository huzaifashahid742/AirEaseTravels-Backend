# =================================================
#  AIREASE TRAVELS & TOURS BACKEND - ENVIRONMENT
# =================================================
# Railway: set these on the SERVICE (Variables tab), not only project Shared Variables.
# Do NOT wrap values in quotes. No spaces around =.

# 1. MongoDB Atlas (URL-encode special chars in password, e.g. @ -> %40)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@aireasetravelsandtoursd.rf6zeb8.mongodb.net/AirEaseTravelsandToursDatabase?appName=AirEaseTravelsandToursDatabase

# 2. Server
NODE_ENV=production
PORT= 8080

# 3. Authentication
JWT_SECRET=your_actual_private_secret_key_here

# 4. Initial Super Admin (for scripts/createAdmin.js)
ADMIN_EMAIL=your-real-admin@email.com
ADMIN_NAME=Your Admin Name
ADMIN_PASSWORD=A_Very_Strong_Secure_Password_Here

# 5. CORS (comma-separated, no trailing slashes)
CORS_ORIGIN=https://aireasetravelstours.vercel.app
FRONTEND_URL=https://aireasetravelstours.vercel.app

# 6. Cloudinary Details 
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
